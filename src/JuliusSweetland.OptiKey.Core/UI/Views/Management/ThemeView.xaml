<UserControl x:Class="JuliusSweetland.OptiKey.UI.Views.Management.ThemeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:prop="clr-namespace:JuliusSweetland.OptiKey.Properties"
             xmlns:vm="clr-namespace:JuliusSweetland.OptiKey.UI.ViewModels.Management"
             d:DataContext="{d:DesignInstance vm:ThemeViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
  <UserControl.Resources>
    <ResourceDictionary Source="/OptiKey;component/Resources/Themes/Colours/ColorPalette.xaml"/>
  </UserControl.Resources>
  <StackPanel>
    <GroupBox Header="Management Console" BorderThickness="0">
      <StackPanel>
        <mah:MetroHeader Header="Accent">
          <mah:ColorPicker mah:TextBoxHelper.ClearTextButton="True"
                             IsAvailableColorPaletteVisible="False"
                             SelectedColor="{Binding Source={x:Static prop:Settings.Default}, Path=AppAccentColor}"
                             SelectedColorChanged="AccentColorChanged"
                             StandardColorPaletteItemsSource="{StaticResource ColorPalette}"/>
        </mah:MetroHeader>
        <mah:MetroHeader Header="Background">
          <ComboBox SelectedItem="{Binding Source={x:Static prop:Settings.Default}, Path=AppTheme}" SelectionChanged="AppThemeChanged">
            <sys:String>Light</sys:String>
            <sys:String>Dark</sys:String>
          </ComboBox>
        </mah:MetroHeader>
      </StackPanel>
    </GroupBox>
    <GroupBox Header="Keyboard" BorderThickness="0">
      <StackPanel>
        <mah:MetroHeader Header="Key Foreground">
          <mah:ColorPicker mah:TextBoxHelper.ClearTextButton="True"
                             IsAvailableColorPaletteVisible="False"
                             SelectedColor="{Binding Source={x:Static prop:Settings.Default}, Path=KeyForeground}"
                             SelectedColorChanged="AccentColorChanged"
                             StandardColorPaletteItemsSource="{StaticResource ColorPalette}"/>
        </mah:MetroHeader>
        <mah:MetroHeader Header="Key Background">
          <mah:ColorPicker mah:TextBoxHelper.ClearTextButton="True"
                             IsAvailableColorPaletteVisible="False"
                             SelectedColor="{Binding Source={x:Static prop:Settings.Default}, Path=KeyBackground}"
                             SelectedColorChanged="AccentColorChanged"
                             StandardColorPaletteItemsSource="{StaticResource ColorPalette}"/>
        </mah:MetroHeader>
        <mah:MetroHeader Header="Key Border Thickness">
          <mah:NumericUpDown Value="{Binding Source={x:Static prop:Settings.Default}, Path=KeyBorderThickness}"/>
        </mah:MetroHeader>
        <mah:MetroHeader Header="Key Corner Radius">
          <mah:NumericUpDown Value="{Binding Source={x:Static prop:Settings.Default}, Path=KeyCornerRadius}"/>
        </mah:MetroHeader>
        <mah:MetroHeader Header="Dwell Border">
        <mah:ColorPicker mah:TextBoxHelper.ClearTextButton="True"
                             IsAvailableColorPaletteVisible="False"
                             SelectedColor="{Binding Source={x:Static prop:Settings.Default}, Path=DwellBorderColor}"
                             SelectedColorChanged="AccentColorChanged"
                             StandardColorPaletteItemsSource="{StaticResource ColorPalette}"/>
        </mah:MetroHeader>
        <mah:MetroHeader Header="Dwell Progress">
          <mah:ColorPicker mah:TextBoxHelper.ClearTextButton="True"
                             IsAvailableColorPaletteVisible="False"
                             SelectedColor="{Binding Source={x:Static prop:Settings.Default}, Path=DwellProgressColor}"
                             SelectedColorChanged="AccentColorChanged"
                             StandardColorPaletteItemsSource="{StaticResource ColorPalette}"/>
        </mah:MetroHeader>
        <mah:MetroHeader Header="Key Selection Flash">
          <mah:ColorPicker mah:TextBoxHelper.ClearTextButton="True"
                             IsAvailableColorPaletteVisible="False"
                             SelectedColor="{Binding Source={x:Static prop:Settings.Default}, Path=KeySelectionFlashColor}"
                             SelectedColorChanged="AccentColorChanged"
                             StandardColorPaletteItemsSource="{StaticResource ColorPalette}"/>
        </mah:MetroHeader>
        <mah:MetroHeader Header="Key Down Foreground">
          <mah:ColorPicker mah:TextBoxHelper.ClearTextButton="True"
                             IsAvailableColorPaletteVisible="False"
                             SelectedColor="{Binding Source={x:Static prop:Settings.Default}, Path=KeyDownForeground}"
                             SelectedColorChanged="AccentColorChanged"
                             StandardColorPaletteItemsSource="{StaticResource ColorPalette}"/>
        </mah:MetroHeader>
      </StackPanel>
    </GroupBox>
  </StackPanel>
</UserControl>